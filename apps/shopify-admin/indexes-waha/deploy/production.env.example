# Use immutable digests where possible. Never use :latest in production.
CADDY_IMAGE=caddy:2.11.7-alpine
WAHA_IMAGE=devlikeapro/waha:latest-2026.9.2

APP_DOMAIN=waha.indexesstore.com
SHOPIFY_APP_URL=https://waha.indexesstore.com
DASHBOARD_DOMAIN=control-waha.indexesstore.com
SHOPIFY_API_KEY=62e6e4cc7b38a2bf6c8a430a9679cc20
SHOPIFY_API_SECRET=
SHOPIFY_ALLOWED_SHOP=ubhd8d-iz.myshopify.com

# Use a new key that is unrelated to Cloudflare, Whapi, or any existing WAHA.
WAHA_API_KEY=
WAHA_SESSION_NAME=default
WHATSAPP_DEFAULT_ENGINE=WEBJS

# The dashboard password must be independent from the API and Shopify secrets.
# Store the Caddy-compatible password hash in single quotes so Compose keeps
# every `$` character literal, for example: '$2a$14$...'.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_HASH=
